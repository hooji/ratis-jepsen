# Launcher for the ratis-kv server. Builds the classpath from ../lib/* and
# execs java in the foreground; all arguments are passed through to Main.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KV_HOME="$(dirname "${BIN_DIR}")"

# slf4j-simple writes to stderr by default; the process contract says stdout.
exec java \
  -Dorg.slf4j.simpleLogger.logFile=System.out \
  -cp "${KV_HOME}/lib/*" \
  ratis.jepsen.kv.Main "$@"
