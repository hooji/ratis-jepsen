<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ratis-jepsen</groupId>
  <artifactId>ratis-kv</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ratis-kv</name>
  <description>
    Standalone key-value server embedding an Apache Ratis RaftServer;
    the ratis-jepsen system under test.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- The Ratis version under test; the harness bumps this per run (DESIGN 1.1). -->
    <ratis.version>3.2.2</ratis.version>
    <!-- Matches the slf4j-api version Ratis 3.2.2 itself depends on. -->
    <slf4j.version>2.0.7</slf4j.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.ratis</groupId>
      <artifactId>ratis-server</artifactId>
      <version>${ratis.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.ratis</groupId>
      <artifactId>ratis-grpc</artifactId>
      <version>${ratis.version}</version>
    </dependency>
    <!-- Without ratis-metrics-default only the metrics API lands and metrics are no-ops. -->
    <dependency>
      <groupId>org.apache.ratis</groupId>
      <artifactId>ratis-metrics-default</artifactId>
      <version>${ratis.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <!--
        `mvn package` additionally produces target/ratis-kv-<version>.tar.gz
        (lib/ with all runtime jars + bin/ratis-kv launcher); this tarball is
        what the harness installs on db nodes. Never committed (.gitignore).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <appendAssemblyId>false</appendAssemblyId>
          <!--
            The tarball name carries the Ratis version under test (Job 12):
            ratis-kv-<version>-ratis-<ratis.version>.tar.gz. Tarballs for
            different Ratis versions coexist in target/ and the harness
            selects by its ‑‑ratis-version flag; the jar keeps the plain
            finalName.
          -->
          <finalName>${project.artifactId}-${project.version}-ratis-${ratis.version}</finalName>
          <descriptors>
            <descriptor>src/assembly/dist.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>dist-tarball</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Version-matrix support (Job 12): resolve Ratis artifacts from one
      extra repository, e.g. an Apache staging repo while a release
      candidate is under vote. Activated only when -Dratis.repo.url=... is
      passed; the default build touches Maven Central alone.
    -->
    <profile>
      <id>extra-ratis-repo</id>
      <activation>
        <property>
          <name>ratis.repo.url</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <id>extra-ratis-repo</id>
          <url>${ratis.repo.url}</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
</project>
