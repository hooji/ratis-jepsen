{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.1"}

  ;; Jepsen 0.3.x — the harness library (client/db/cli/generator protocols).
  jepsen/jepsen {:mvn/version "0.3.13"}

  ;; Ratis client stack at the evaluated pin (PLAN Q15). The harness talks
  ;; to the cluster via direct RaftClient interop (PLAN Q1); grpc is the
  ;; client rpc transport the SUT speaks. metrics-default: the client
  ;; references org.apache.ratis.metrics.RatisMetrics at runtime and
  ;; MetricRegistries.global() service-loads an implementation whose
  ;; absence is a hard ExceptionInInitializerError, not a no-op —
  ;; ratis-client pulls neither transitively (both found the hard way in
  ;; Job 04's first cluster runs).
  ;;
  ;; Version matrix (Job 12): these pins are the DEFAULT. A --ratis-version
  ;; run must match the harness client to the server under test, which
  ;; env/run.sh does at launch via -Sdeps {:aliases {:sut-ratis
  ;; {:override-deps {...}}}} over these three coordinates (deps.edn is
  ;; static — JVM deps cannot change after start, so the flag's owner is
  ;; the launcher, not the CLI). core.clj's check-client-version! then
  ;; refuses to run if the real classpath disagrees with the flag.
  org.apache.ratis/ratis-client {:mvn/version "3.2.2"}
  org.apache.ratis/ratis-grpc {:mvn/version "3.2.2"}
  org.apache.ratis/ratis-metrics-default {:mvn/version "3.2.2"}}

 :aliases
 {;; Main entry: clojure -M:run test --help (jepsen.cli).
  ;; Heap: knossos's linear checker is the run's binding resource (PLAN
  ;; Q7); partition-window :info ops multiply its search space, and the
  ;; JVM's ergonomic 25%-of-RAM default OOMed a reference run's analysis.
  :run
  {:jvm-opts ["-Xmx10g"]
   :main-opts ["-m" "ratis-jepsen.core"]}

  ;; Unit + in-JVM integration tests: clojure -M:test (in the shipped
  ;; environment: env/run.sh selftest, which installs the SUT jar and
  ;; runs this alias inside control). The SUT jar must be installed
  ;; first:
  ;;   sut/ratis-kv/mvnw -f sut/ratis-kv/pom.xml -q install
  ;; (test-only dep: the integration test boots 3 in-process ratis-kv
  ;; servers; the harness proper never depends on SUT internals.)
  ;;
  ;; The runner is our own ratis-jepsen.test-runner (test/, Job 17):
  ;; cognitect test-runner is distributed as a GIT dependency only,
  ;; and resolving it needs a working git at classpath-build time —
  ;; which the control container did not have, so the documented
  ;; command failed before loading a single test (capstone §2.4).
  ;; Plain clojure.test + tools.namespace are ordinary Maven deps; the
  ;; classpath now resolves from the Maven repo alone.
  :test
  {:extra-paths ["test"]
   :extra-deps
   {ratis-jepsen/ratis-kv {:mvn/version "0.1.0-SNAPSHOT"}
    org.clojure/tools.namespace {:mvn/version "1.5.1"}}
   :main-opts ["-m" "ratis-jepsen.test-runner"]}

  ;; The Job 12 library probe (BACKLOG 7/8 at an arbitrary version):
  ;; in-JVM RaftServers on a deliberately naive BaseStateMachine subclass
  ;; — needs ratis-server, which the harness proper never depends on.
  ;; The version comes from the same -Sdeps :override-deps injection as
  ;; everything else (env/run.sh probe); the pin below is the default.
  :probe
  {:extra-paths ["probe"]
   :extra-deps {org.apache.ratis/ratis-server {:mvn/version "3.2.2"}}
   :main-opts ["-m" "ratis-jepsen.probe.lifecycle"]}}}
