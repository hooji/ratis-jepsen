# Baked into the image at /root/.ssh/config. Only used outbound from
# control; the compose network is private and containers are throwaway, so
# host-key verification is deliberately disabled for the seven db nodes.
Host n1 n2 n3 n4 n5 n6 n7
  User root
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
